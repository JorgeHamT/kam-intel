{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "dynamicRoutes": [
    {
      "page": "/kams/[kamId]",
      "regex": "^/kams/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPkamId": "nxtPkamId"
      },
      "namedRegex": "^/kams/(?<nxtPkamId>[^/]+?)(?:/)?$"
    },
    {
      "page": "/restaurants/[restaurantId]",
      "regex": "^/restaurants/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPrestaurantId": "nxtPrestaurantId"
      },
      "namedRegex": "^/restaurants/(?<nxtPrestaurantId>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/alerts",
      "regex": "^/alerts(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/alerts(?:/)?$"
    },
    {
      "page": "/data-validation",
      "regex": "^/data\\-validation(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/data\\-validation(?:/)?$"
    },
    {
      "page": "/deck",
      "regex": "^/deck(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/deck(?:/)?$"
    },
    {
      "page": "/kams",
      "regex": "^/kams(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/kams(?:/)?$"
    },
    {
      "page": "/validation",
      "regex": "^/validation(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/validation(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "RSC",
    "varyHeader": "RSC, Next-Router-State-Tree, Next-Router-Prefetch, Next-Router-Segment-Prefetch",
    "prefetchHeader": "Next-Router-Prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "Next-Router-Segment-Prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments"
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  },
  "rewrites": []
}
